## 8. 关键 Hook 设计

### 8.1 `useSpatialData`

```typescript
function useSpatialData(storeId: string) {
  const setSpatial = useSpatialStore((s) => s.loadSpatial);
  return useQuery({
    queryKey: ['spatial', storeId],
    queryFn: () => fetchSpatial(storeId),
    staleTime: 5 * 60 * 1000,
    onSuccess: (data) => setSpatial(data),
  });
}
```

### 8.2 `useReplenishStream`

```typescript
function useReplenishStream(storeId: string) {
  const [lastEvent, setLastEvent] = useState<ReplenishEvent | null>(null);
  useEffect(() => {
    const ws = new WebSocket(`${WS_BASE}/ws/replenish?store=${storeId}`);
    ws.onmessage = (msg) => setLastEvent(JSON.parse(msg.data));
    ws.onerror = () => reconnect(ws);
    return () => ws.close();
  }, [storeId]);
  return { lastEvent };
}
```

### 8.3 `useThreeCamera`

```typescript
function useThreeCamera(controls: 'orbit' | 'fly' | 'topdown') {
  const { camera, gl } = useThree();
  useEffect(() => {
    if (controls === 'orbit') {
      const orbit = new OrbitControls(camera, gl.domElement);
      orbit.enableDamping = true;
      return () => orbit.dispose();
    }
    // ...
  }, [controls, camera, gl]);
}
```

